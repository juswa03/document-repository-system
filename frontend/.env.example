VITE_API_URL=http://localhost:8000/api

# Live notification push (Phase 35) — copy the non-secret REVERB_* values
# from backend/.env (never the app secret). Leave unset and the bell
# just falls back to polling.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
